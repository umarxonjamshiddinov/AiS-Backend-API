# AiS stores only hashes of downstream user keys. This is a SERVER Bedrock bearer.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
AI_DEFAULT_MAX_OUTPUT_TOKENS=4096
AI_REQUEST_TIMEOUT_SECONDS=120
AI_RETRY_COUNT=2
AI_RETRY_BACKOFF_SECONDS=0.5
VISION_HELPER_MODEL_KEY=qwen3_vl_235b_a22b
MODERATION_MODEL_KEY=gpt_oss_safeguard_20b

DATABASE_URL=
# External DB example: postgresql+psycopg://ais:CHANGE_ME@127.0.0.1:5432/ais
# Leave both URLs empty for scripts/setup_local_db.py to create local databases.
# Dedicated test database; never point integration tests at production.
TEST_DATABASE_URL=

# Required for /admin; CLI management needs only server/DB access.
ADMIN_TOKEN=
RESERVATION_TTL_SECONDS=180
RESERVATION_HEARTBEAT_SECONDS=30
RESERVATION_REAPER_SECONDS=30

# Existing Converse aliases only. Also accepted as a legacy server-credential
# fallback for Mantle when OPENAI_API_KEY is empty; never a downstream AiS key.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
