# Amazon Bedrock Mantle server credential (legacy OPENAI_API_KEY name).
# Provider credentials are optional until an administrator configures a provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1

# Public URL shown when an API key is issued. Leave empty to derive it from
# the ASGI request origin and configured root_path. Uvicorn proxy headers
# must be trusted only from explicitly configured proxy IPs.
# Example: https://ai.example.com/v1
PUBLIC_API_BASE_URL=

# PostgreSQL URLs. Create separate local ais and ais_test databases.
# Example: postgresql+psycopg://ais_owner:replace_me@127.0.0.1:55432/ais
DATABASE_URL=
# Tests require a local PostgreSQL database named ais_test.
# Example: postgresql+psycopg://ais_owner:replace_me@127.0.0.1:55432/ais_test
TEST_DATABASE_URL=

# Required for /admin and /admin/api; generate a unique local value.
ADMIN_TOKEN=

# Bedrock Converse/Mantle settings.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0

# Request limits and reservation lifecycle.
AI_DEFAULT_MAX_OUTPUT_TOKENS=4096
AI_REQUEST_TIMEOUT_SECONDS=120
AI_RETRY_COUNT=2
AI_RETRY_BACKOFF_SECONDS=0.5
VISION_HELPER_MODEL_KEY=qwen3_vl_235b_a22b
MODERATION_MODEL_KEY=gpt_oss_safeguard_20b
RESERVATION_TTL_SECONDS=180
RESERVATION_HEARTBEAT_SECONDS=30
RESERVATION_REAPER_SECONDS=30
